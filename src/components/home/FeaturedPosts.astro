---
import { Image } from 'astro:assets'
import { getBlogCollection, sortMDByDate } from '@/utils/server'
import { FormattedDate } from '@/components/user'

const posts = sortMDByDate(await getBlogCollection()).slice(0, 4)
---

<section class='w-full'>
  <div class='mb-5 flex items-end justify-between gap-4'>
    <h2 class='text-xl font-semibold'>Latest Articles</h2>
    <a href='/blog/research' class='text-sm text-muted-foreground transition-colors hover:text-primary'>View all →</a>
  </div>
  <div class='grid grid-cols-1 gap-4 sm:grid-cols-2'>
    {posts.map((post) => (
      <a href={`/blog/${post.id}`} class='group overflow-hidden rounded-2xl border border-border bg-card transition-all duration-300 hover:-translate-y-1 hover:border-primary/25 hover:shadow-lg'>
        {post.data.heroImage && (
          <Image
            src={post.data.heroImage.src}
            alt={post.data.heroImage.alt || post.data.title}
            width={post.data.heroImage.width || 800}
            height={post.data.heroImage.height || 420}
            class='h-32 w-full object-cover transition-transform duration-500 group-hover:scale-105'
            loading='lazy'
          />
        )}
        <div class='p-5'>
          <div class='mb-2 text-xs text-muted-foreground'><FormattedDate date={post.data.updatedDate || post.data.publishDate} /></div>
          <h3 class='line-clamp-2 font-semibold transition-colors group-hover:text-primary'>{post.data.title}</h3>
          {post.data.description && <p class='mt-2 line-clamp-2 text-sm text-muted-foreground'>{post.data.description}</p>}
        </div>
      </a>
    ))}
  </div>
</section>
