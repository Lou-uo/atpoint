<div class='sakura-layer' aria-hidden='true'>
  {Array.from({ length: 18 }).map((_, index) => (
    <span class='petal' style={`--i:${index}; --left:${(index * 17) % 100}%; --delay:${(index % 9) * 1.4}s; --duration:${10 + (index % 6)}s; --size:${8 + (index % 4) * 3}px;`} />
  ))}
</div>

<style>
  .sakura-layer { position: fixed; inset: 0; z-index: 1; pointer-events: none; overflow: hidden; }
  .petal { position: absolute; top: -2rem; left: var(--left); width: var(--size); height: calc(var(--size) * .72); border-radius: 75% 15% 75% 15%; background: hsl(345 75% 84% / .62); filter: blur(.1px); animation: sakura-fall var(--duration) linear var(--delay) infinite; }
  .dark .petal { background: hsl(345 55% 68% / .28); }
  @keyframes sakura-fall {
    0% { transform: translate3d(0, -5vh, 0) rotate(0deg); opacity: 0; }
    10% { opacity: .7; }
    50% { transform: translate3d(7vw, 52vh, 0) rotate(180deg); }
    100% { transform: translate3d(-8vw, 112vh, 0) rotate(360deg); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .petal { animation: none; opacity: .18; } }
</style>
