---
import PageLayout from '@/layouts/CommonPage.astro'
import {
  Button,
  Icon,
  PublicationSection,
  ResearchProjectSection,
  SimpleIcon
} from '@/components/user'
import config from '@/site-config'

const headings = [
  { depth: 2, slug: 'about-me', text: 'About Me' },
  { depth: 2, slug: 'research-interests', text: 'Research Interests' },
  { depth: 2, slug: 'publications', text: 'Publications' },
  { depth: 2, slug: 'open-source-projects', text: 'Open-source Projects' }
]
---

<PageLayout title='Academic' {headings} info={{ slug: '/academic', hideComment: true }}>
  <h2 id='about-me'>About Me<a class='anchor' href='#about-me'>#</a></h2>
  <p>
    I am a sophomore student at the School of <a href="https://jsjytx.neuq.edu.cn/" target="_blank" rel="noopener noreferrer">Computer and Communication Engineering</a>, <a href="https://www.neuq.edu.cn/" target="_blank" rel="noopener noreferrer">Northeastern University (Qinhuangdao)</a>. Currently, I am working as a Research Assistant at <a href="https://www.nju-link.com/en/" target="_blank" rel="noopener noreferrer">NJU-LINK Lab</a>, supervised by Professor <a href="https://yuxiangren.github.io/" target="_blank" rel="noopener noreferrer">Yuxiang Ren</a>, with a research focus on Agent.
  </p>

  <p>My research philosophy: Chase the trends of the times.</p>
  <p>
    Currently, I am researching the deployment and optimization of Agent applications in the field of personalized memory. Prior to this, I have practical experience in projects related to NLP, Diffusion, ESN, and other areas. For detailed information, please follow my blog and <a href="https://github.com/Lou-uo" target="_blank" rel="noopener noreferrer">GitHub</a>.
  </p>

  <p>Here is my academic CV, feel free to download it.</p>
  <Button title='Download CV' class='w-fit' href='/cv.pdf' target='_blank'>
    <Icon class='size-5' name='download' slot='before' />
  </Button>
  <h2 id='research-interests'>
    Research Interests<a class='anchor' href='#research-interests'>#</a>
  </h2>
  <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3'>
    {
      [
        {
          title: 'Agent Memory',
          description: 'Research the deployment and optimization of Agent applications in the field of personalized memory.',
          icon: 'langchain'
        },
        {
          title: 'Agent Compression',
          description: 'Study how to compress the trajectory of Agent.',
          icon: 'pytorch'
        },
        {
          title: 'Physical Simulation',
          description: 'Learn to construct Physical Simulation Based on MuJoCo.',
          icon: 'openaigym'
        }
        // {
        //   title: '研究方向 3',
        //   description: '关于该研究方向的详细描述，包括关键词等。',
        //   icon: 'pytorch'
        // }
      ].map((interest) => (
        <div class='group relative overflow-hidden rounded-xl border border-border bg-card p-4 transition-all hover:border-foreground/25 hover:shadow-md'>
          <div class='flex items-start gap-4'>
            <div class='flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 transition-colors group-hover:bg-primary/20'>
              <SimpleIcon
                class='size-5 text-primary transition-transform duration-300 group-hover:scale-110'
                name={interest.icon}
              />
            </div>
            <div class='flex-1'>
              <p class='text-xl font-medium leading-tight text-foreground transition-colors group-hover:text-primary'>
                {interest.title}
              </p>
              <p class='text-sm leading-relaxed text-muted-foreground'>{interest.description}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
  <h2 id='publications'>Publications<a class='anchor' href='#publications'>#</a></h2>
  <PublicationSection
    publications={[
    //   {
    //     title:
    //       'ESN Anomaly Detection',
    //     authors: [
    //       { name: 'XX', isEqual: true }
    //     ],
    //     venue: 'XX',
    //     year: '2026',
    //     type: 'journal',
    //     abstract:
    //       '…………',
    //     links: [
    //       { type: 'github', href: 'https://github.com/Lou-uo/ESN-for-Anomaly-Dectection', label: 'Code' }
    //     ],
    //     status: 'writing'
    //   },
      {
        title:
          'Who Schedules Agent Memory? A Sidecar Approach to Long-Horizon Tasks',
        authors: [
          { name: 'Qijia Zhuang', isEqual: true },
          { name: 'Rui Liu', isEqual: true, isMe: true },
          { name: 'Yuxiang Ren' }
        ],
        venue: 'arxiv Preprint',
        year: '2026',
        type: 'preprint',
        abstract:
          'As large language model agents increasingly undertake complex, long-horizon tasks, memory has become an important component for supporting sustained decision-making and action. Existing methods primarily focus on memory storage, updating, and retrieval, but often overlook how memory scheduling affects task execution: the main agent must identify memory needs, initiate retrieval, and wait for results while advancing the task, increasing both scheduling burden and execution time. To address this problem, we propose MemSidecar, which decouples memory scheduling from task execution through two independently selectable modes. Hooks directly delivers bound memory to the main agent when execution events match predefined conditions. Foresight uses an independent agent to predict potential queries, retrieve results in parallel, and store them in a cache, delivering matching and valid results when actual requests arrive. Hooks and Foresight achieve scores of 41.23% and 44.34% on MCP-Persona, respectively, while effectively reducing execution costs and latency and improving the efficiency of long-horizon agent execution.',
        links: [
        //   { type: 'website', href: '#' },
          { type: 'arxiv', href: 'https://arxiv.org/abs/2611.00779' }
        //   { type: 'github', href: '#', label: 'Code' }
        ],
        status: 'preprint'
      },
      {
        title:
          'Rethinking Agent Trajectory Compression: A Workflow-Aware Perspective',
        authors: [
          { name: 'Qijia Zhuang', isEqual: true },
          { name: 'Rui Liu', isEqual: true, isMe: true },
          { name: 'Wenqi Hu' },
          { name: 'Yuxiang Ren' }
        ],
        venue: 'arxiv Preprint',
        year: '2026',
        type: 'preprint',
        abstract:
          'As long-horizon agents increasingly rely on multi-step tool interactions to accomplish complex tasks, their execution trajectories continuously accumulate structured outputs and intermediate artifacts, leading to growing context overhead. Existing compression methods primarily rely on text importance or fixed truncation rules, often overlooking cross-step dependencies within workflows and potentially discarding critical information required for subsequent task execution. To address this challenge, we propose WAAC, a workflow-aware framework for agent trajectory compression. WAAC structurally models successful historical trajectories to extract reusable workflow compression experience and incorporates online backward dependency analysis to dynamically identify information retention requirements. By combining current dependency constraints with historical experience, WAAC selects appropriate compression strategies for different types of historical information. Experiments on PinchBench and Odysseys demonstrate that WAAC achieves an overall score of 87.6 and a perfect completion rate of 19.0%, respectively, while reducing execution costs by 19.7% and 29.1% compared with the strongest baseline methods. These results demonstrate the effectiveness of workflow-aware trajectory compression in improving task performance and cost efficiency for long-horizon agents.',
        links: [
        //   { type: 'website', href: '#' },
          { type: 'arxiv', href: 'https://arxiv.org/abs/2611.08865' },
          { type: 'github', href: 'https://anonymous.4open.science/r/waac-6527/README.md', label: 'Code' }
        ],
        status: 'preprint'
      }
    ]}
  />
  <h2 id='open-source-projects'>
    Open-source Projects<a class='anchor' href='#open-source-projects'>#</a>
  </h2>
  <ResearchProjectSection
    projects={[
      {
        title: 'LongChain-chatchat',
        description:
          'Local knowledge base based on RAG implementation',
        category: 'LangChain + RAG Implementation',
        status: 'completed',
        links: [
          { type: 'github', href: 'https://github.com/Lou-uo/classic-replication/blob/main/chatchat/chat2.md', label: 'Code' }
        ]
      },
      {
        title: 'Emotional Classification',
        description:
          'Emotional classification of English film reviews',
        category: 'TF-IDF + Logistic Regression',
        status: 'completed',
        links: [
          { type: 'github', href: 'https://github.com/Lou-uo/natural-language-processing/blob/main/emotional%20classification%20of%20film%20reviews/TestResult.md', label: 'Code' }
        ]
      },
      {
        title: 'Machine Translation',
        description:
          'Compare the translation ability of Transformer and Seq2Seq.',
        category: 'Transformer VS Seq2Seq',
        status: 'completed',
        links: [
          { type: 'github', href: 'https://github.com/Lou-uo/classic-replication/blob/main/Transformer/machine-translation-project/TrainingLog.md', label: 'Code' }
        ]
      },
      {
        title: 'Style Rendering',
        description:
          'Pixel Style Rendering of text-to-image',
        category: 'Stable Diffusion',
        status: 'completed',
        links: [
          { type: 'modelscope', href: 'https://www.modelscope.cn/models/L13739092955/LoRA-pixel2', label: 'ModelScope' }
        ]
      }
    ]}
  />
</PageLayout>

<script
  is:inline
  type='module'
  data-astro-rerun
  define:vars={{ npmCDN: config.npmCDN, walineServer: config.integ.waline.server }}
>
  const normalizePath = (path) => {
    if (path === '/') return path
    return path.endsWith('/') ? path.slice(0, -1) : path
  }

  const loadPageviewCount = async () => {
    const pageview = await import(`${npmCDN}/@waline/client@v3/dist/pageview.js`)
    pageview.pageviewCount({
      serverURL: walineServer,
      path: normalizePath(window.location.pathname)
    })
  }

  await loadPageviewCount()
</script>
